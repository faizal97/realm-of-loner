# build output (build.py and flutter regenerate these)
dist/
dist-dev/
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/assets/game/index.html
app/android/local.properties
app/android/.gradle/
*.apk

# rendered art and audio working files (regenerate with the render/compose scripts)
art/out/
art/*/out/
audio/wav/
audio/preview/
__pycache__/
*.pyc

# local tooling
.claude/
.DS_Store
*.iml
.idea/

# music files the build copies next to the app page (from audio/out)
app/assets/game/music/
